rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 학생 출제 문제: 누구나 읽기·올리기, 고치기는 오류 신고(reports +1)만, 지우기는 콘솔에서 교사만
    match /studentProblems/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['nick', 'topic', 'c', 'lv', 'q', 'box', 'ch', 'ans', 'exp', 'created', 'reports'])
        && request.resource.data.keys().hasAll(['nick', 'topic', 'c', 'lv', 'q', 'box', 'ch', 'ans', 'exp', 'created', 'reports'])
        && str(request.resource.data.nick, 1, 12)
        && str(request.resource.data.topic, 1, 20)
        && request.resource.data.c is list && request.resource.data.c.size() >= 1 && request.resource.data.c.size() <= 10
        && request.resource.data.lv in [1, 2, 3]
        && str(request.resource.data.q, 1, 120)
        && str(request.resource.data.box, 0, 400)
        && request.resource.data.ch is list && request.resource.data.ch.size() == 5
        && str(request.resource.data.ch[0], 1, 80) && str(request.resource.data.ch[1], 1, 80)
        && str(request.resource.data.ch[2], 1, 80) && str(request.resource.data.ch[3], 1, 80)
        && str(request.resource.data.ch[4], 1, 80)
        && request.resource.data.ans in [1, 2, 3, 4, 5]
        && str(request.resource.data.exp, 1, 400)
        && request.resource.data.created is int
        && request.resource.data.reports == 0;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports'])
        && request.resource.data.reports == resource.data.reports + 1;

      allow delete: if false;
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
  }
}
